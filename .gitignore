# Packaged charts, and the output of `helm package`.
dist/
*.tgz

# ...except the vendored subcharts, which are committed on purpose so the gate is
# stateless and offline, and so `helm package` publishes what the gate verified.
!charts/*/charts/*.tgz

# Written by scripts/vendor-charts.sh. Derived from the exact pins in Chart.yaml, so
# it carries no information the pins do not.
charts/*/Chart.lock

# Env files
.env
.env.local

# Editor/IDE
.idea/
.vscode/
